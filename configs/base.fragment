# Void Kernel base fragment - applied to every build
# Root-solution support (KernelSU / KernelSU Next / SukiSU use kprobes
# for syscall hooking on this non-GKI kernel)
CONFIG_KPROBES=y

# Allow runtime SELinux mode switching from userspace
CONFIG_SECURITY_SELINUX_DEVELOP=y

# Enable every stock governor not already on (schedutil/interactive are on)
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y

# Void custom governors (7 stock + 13 custom = 20 total)
CONFIG_CPU_FREQ_GOV_DARKNESS=y
CONFIG_CPU_FREQ_GOV_NIGHTMARE=y
CONFIG_CPU_FREQ_GOV_INTELLIDEMAND=y
CONFIG_CPU_FREQ_GOV_ALUCARD=y
CONFIG_CPU_FREQ_GOV_BLU_ACTIVE=y
CONFIG_CPU_FREQ_GOV_INTELLIACTIVE=y
CONFIG_CPU_FREQ_GOV_YANKACTIVE=y
CONFIG_CPU_FREQ_GOV_LIONFISH=y
CONFIG_CPU_FREQ_GOV_IMPULSE=y
CONFIG_CPU_FREQ_GOV_WAVE=y
CONFIG_CPU_FREQ_GOV_SMARTASS2=y
CONFIG_CPU_FREQ_GOV_SMARTMAX=y
CONFIG_CPU_FREQ_GOV_SMARTMAX_EPS=y
