#!/system/bin/sh
# voidman - Void Kernel Manager CLI
# Manage the 20-governor Void Kernel for exynos9810 (S9 / S9+ / Note 9).
VERSION="1.1"
CPU=/sys/devices/system/cpu
CONF=/data/adb/void_kernel_manager/profile.conf

need_root() {
    if [ "$(id -u)" != "0" ]; then
        echo "voidman: root required (run via su)" >&2
        exit 1
    fi
}

list_policies() {
    SEEN=""
    for cf in $CPU/cpu*/cpufreq; do
        [ -d "$cf" ] || continue
        P=$(readlink -f "$cf")
        case " $SEEN " in *" $P "*) continue ;; esac
        SEEN="$SEEN $P"
        echo "$P $(cat "$P/cpuinfo_max_freq" 2>/dev/null || echo 0)"
    done | sort -k2 -n | awk '{print $1}'
}

policy_for() {
    case "$1" in
        little) list_policies | head -n 1 ;;
        big)    list_policies | tail -n 1 ;;
        all)    list_policies ;;
        *)      echo "" ;;
    esac
}

detect_root_solution() {
    # KernelSU-family kernels expose a version node in debugfs/sysfs.
    if [ -r /sys/kernel/kernelsu/version ]; then
        echo "KernelSU-compatible (version $(cat /sys/kernel/kernelsu/version 2>/dev/null))"
        return
    fi
    if [ -d /sys/kernel/kernelsu ]; then
        echo "KernelSU-compatible"
        return
    fi
    if [ -n "$(ksud --help 2>/dev/null)" ]; then
        echo "ksud present"
        return
    fi
    echo "unknown"
}

is_num() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

cmd_status() {
    echo "Void Kernel Manager v$VERSION"
    echo "Kernel : $(uname -r)"
    echo "SELinux: $(getenforce 2>/dev/null || echo unknown)"
    echo "Root   : $(detect_root_solution)"
    echo ""
    for p in $(list_policies); do
        CLUSTER=$([ "$p" = "$(policy_for little)" ] && echo little || echo big)
        echo "[$CLUSTER] $p"
        echo "  governor: $(cat $p/scaling_governor 2>/dev/null)"
        echo "  cur     : $(cat $p/scaling_cur_freq 2>/dev/null)"
        echo "  min/max : $(cat $p/scaling_min_freq 2>/dev/null)/$(cat $p/scaling_max_freq 2>/dev/null)"
        echo "  hw range: $(cat $p/cpuinfo_min_freq 2>/dev/null)-$(cat $p/cpuinfo_max_freq 2>/dev/null)"
    done
    echo ""
    echo "Governors available:"
    echo "  $(cat $(policy_for big)/scaling_available_governors 2>/dev/null || cat $CPU/cpu0/cpufreq/scaling_available_governors 2>/dev/null)"
}

cmd_govs() {
    cat "$(policy_for big)/scaling_available_governors" 2>/dev/null \
        || cat $CPU/cpu0/cpufreq/scaling_available_governors 2>/dev/null
}

setgov() {
    ROLE="$1"; GOV="$2"
    if [ -z "$GOV" ]; then
        echo "voidman: usage: voidman setgov <little|big|all> <governor>" >&2
        exit 1
    fi
    need_root
    for p in $(policy_for "$ROLE"); do
        if ! grep -qw "$GOV" "$p/scaling_available_governors" 2>/dev/null; then
            echo "voidman: '$GOV' not available on $p" >&2
            exit 1
        fi
        echo "$GOV" > "$p/scaling_governor"
        echo "$p -> $GOV"
    done
}

freqset() {
    ROLE="$1"; WHICH="$2"; VAL="$3"
    if ! is_num "$VAL"; then
        echo "voidman: frequency must be a number in kHz (got '$VAL')" >&2
        exit 1
    fi
    FILE="scaling_${WHICH}_freq"
    need_root
    for p in $(policy_for "$ROLE"); do
        echo "$VAL" > "$p/$FILE" 2>/dev/null || { echo "voidman: failed to write $p/$FILE" >&2; continue; }
        echo "$p/$FILE = $(cat "$p/$FILE")"
    done
}

apply_profile_file() {
    F="$1"
    . "$F"
    [ -n "$LITTLE_GOVERNOR" ] && setgov little "$LITTLE_GOVERNOR" >/dev/null
    [ -n "$BIG_GOVERNOR" ] && setgov big "$BIG_GOVERNOR" >/dev/null
    [ -n "$LITTLE_MIN" ] && freqset little min "$LITTLE_MIN" >/dev/null
    [ -n "$LITTLE_MAX" ] && freqset little max "$LITTLE_MAX" >/dev/null
    [ -n "$BIG_MIN" ] && freqset big min "$BIG_MIN" >/dev/null
    [ -n "$BIG_MAX" ] && freqset big max "$BIG_MAX" >/dev/null
    echo "profile applied."
}

save_current() {
    need_root
    mkdir -p "$(dirname "$CONF")"
    L=$(policy_for little); B=$(policy_for big)
    cat > "$CONF" <<EOF
# Void Kernel Manager saved profile (applied at boot)
LITTLE_GOVERNOR=$(cat $L/scaling_governor)
LITTLE_MIN=$(cat $L/scaling_min_freq)
LITTLE_MAX=$(cat $L/scaling_max_freq)
BIG_GOVERNOR=$(cat $B/scaling_governor)
BIG_MIN=$(cat $B/scaling_min_freq)
BIG_MAX=$(cat $B/scaling_max_freq)
EOF
    chmod 0644 "$CONF"
    echo "saved current settings to $CONF (boot-persistent)"
}

builtin_profile() {
    L=$(policy_for little); B=$(policy_for big)
    LMAX=$(cat $L/cpuinfo_max_freq); BMAX=$(cat $B/cpuinfo_max_freq)
    LMIN=$(cat $L/cpuinfo_min_freq); BMIN=$(cat $B/cpuinfo_min_freq)

    case "$1" in
        battery)
            echo "LITTLE_GOVERNOR=smartmax_eps" > /tmp/dsprof
            echo "LITTLE_MIN=$LMIN" >> /tmp/dsprof
            echo "LITTLE_MAX=$((LMAX * 60 / 100))" >> /tmp/dsprof
            echo "BIG_GOVERNOR=smartmax_eps" >> /tmp/dsprof
            echo "BIG_MIN=$BMIN" >> /tmp/dsprof
            echo "BIG_MAX=$((BMAX * 55 / 100))" >> /tmp/dsprof
            ;;
        balanced)
            echo "LITTLE_GOVERNOR=schedutil" > /tmp/dsprof
            echo "LITTLE_MIN=$LMIN" >> /tmp/dsprof
            echo "LITTLE_MAX=$LMAX" >> /tmp/dsprof
            echo "BIG_GOVERNOR=schedutil" >> /tmp/dsprof
            echo "BIG_MIN=$BMIN" >> /tmp/dsprof
            echo "BIG_MAX=$BMAX" >> /tmp/dsprof
            ;;
        performance)
            echo "LITTLE_GOVERNOR=intelliactive" > /tmp/dsprof
            echo "LITTLE_MIN=$((LMAX * 50 / 100))" >> /tmp/dsprof
            echo "LITTLE_MAX=$LMAX" >> /tmp/dsprof
            echo "BIG_GOVERNOR=darkness" >> /tmp/dsprof
            echo "BIG_MIN=$((BMAX * 50 / 100))" >> /tmp/dsprof
            echo "BIG_MAX=$BMAX" >> /tmp/dsprof
            ;;
        gaming)
            echo "LITTLE_GOVERNOR=performance" > /tmp/dsprof
            echo "LITTLE_MIN=$LMAX" >> /tmp/dsprof
            echo "LITTLE_MAX=$LMAX" >> /tmp/dsprof
            echo "BIG_GOVERNOR=performance" >> /tmp/dsprof
            echo "BIG_MIN=$BMAX" >> /tmp/dsprof
            echo "BIG_MAX=$BMAX" >> /tmp/dsprof
            ;;
        *) echo "voidman: unknown profile '$1'" >&2; exit 1 ;;
    esac
    apply_profile_file /tmp/dsprof
}

set_selinux() {
    need_root
    if [ -z "${1:-}" ]; then
        getenforce 2>/dev/null || echo unknown
        return
    fi
    case "$1" in
        enforcing)  V=1 ;;
        permissive) V=0 ;;
        *) echo "voidman: expected enforcing|permissive" >&2; exit 1 ;;
    esac
    # Prefer the sysfs node: the toybox 'setenforce' binary is not everywhere.
    if [ -w /sys/fs/selinux/enforce ]; then
        echo "$V" > /sys/fs/selinux/enforce
    else
        setenforce "$([ "$V" = 1 ] && echo enforcing || echo permissive)" 2>/dev/null
    fi
    getenforce 2>/dev/null || echo unknown
}

usage() {
    cat <<EOF
Void Kernel Manager v$VERSION - usage:
  voidman status                            show kernel/root/SELinux/policy state
  voidman govs                              list all available governors
  voidman setgov <little|big|all> <governor>
  voidman freq <little|big> <min|max> <kHz>
  voidman profile battery|balanced|performance|gaming
  voidman save                              persist current settings (applied at boot)
  voidman selinux                           get SELinux mode
  voidman selinux enforcing|permissive
  voidman version                           print CLI version
EOF
}

[ $# -lt 1 ] && { usage; exit 0; }

case "$1" in
    status|info) cmd_status ;;
    govs|governors) cmd_govs ;;
    setgov) shift; setgov "$@" ;;
    freq)   shift; freqset "$@" ;;
    profile) shift; need_root; builtin_profile "$1" ;;
    save)   save_current ;;
    selinux)
        shift
        set_selinux "$@"
        ;;
    version|--version|-v) echo "voidman v$VERSION" ;;
    help|--help|-h) usage ;;
    *) usage; exit 1 ;;
esac
